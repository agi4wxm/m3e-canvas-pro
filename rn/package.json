{
  "name": "m3e-canvas-rn",
  "version": "0.1.0",
  "private": true,
  "description": "React Native rendering of M3E Canvas parts: the kit an exported mobile app is built on, and a gallery app to check it.",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint --max-warnings 0 .",
    "test": "jest",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:android": "expo export --platform android --output-dir dist/android",
    "check": "npm run typecheck && npm run lint && npm test && npm run export:web && npm run export:android"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "58.0.23",
    "expo-blur": "58.0.5",
    "expo-image": "58.0.18",
    "expo-linear-gradient": "58.0.3",
    "expo-status-bar": "58.0.4",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "tailwindcss": "3.4.19",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  }
}
