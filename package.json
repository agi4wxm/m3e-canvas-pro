{
  "name": "m3e-canvas-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Assemble interactive UI prototypes in the browser from Material 3 Expressive parts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agifirefly-wu/m3e-canvas-pro.git"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "gen:parts": "node scripts/gen-parts-components.mjs",
    "gen:agent": "bun scripts/gen-agent.ts",
    "gen:icons": "node scripts/icons.mjs --src components/m3e --dir components/m3e",
    "check:icons": "node scripts/icons.mjs --check --src components/m3e --dir components/m3e",
    "gen:icon-sets": "bun scripts/gen-icon-sets.ts",
    "check:icon-sets": "bun scripts/gen-icon-sets.ts --check",
    "gen:tokens": "bun scripts/gen-tokens.ts",
    "check:export": "bun scripts/check-export.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@iconify/react": "^6.0.2",
    "@material/material-color-utilities": "^0.4.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-router": "^1.170.40",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.5.0",
    "motion": "^13.4.4",
    "node-vibrant": "^4.0.4",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.1",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@iconify-json/ant-design": "^1.2.9",
    "@iconify-json/codicon": "^1.2.77",
    "@iconify-json/f7": "^1.2.2",
    "@iconify-json/fluent": "^1.2.61",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify-json/material-symbols": "^1.2.97",
    "@iconify-json/material-symbols-light": "^1.2.98",
    "@iconify-json/mingcute": "^1.2.9",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/pixelarticons": "^1.2.10",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/tabler": "^1.2.43",
    "@tailwindcss/vite": "^4",
    "@tanstack/router-plugin": "^1.168.41",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
